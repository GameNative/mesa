layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer OutWords { uint w[]; };
layout(push_constant) uniform PC {
   uvec2 src;
   uvec2 dst;
   uint src_row_pitch;
   uint src_slice_pitch;
   uint dst_row_pitch;
   uint dst_slice_pitch;
   uint blocks_x;
   uint blocks_y;
   uint block;
   uint kind;
   uint width;
   uint height;
} pc;
