#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
/*
 * ASTC LDR encode, one invocation per block (4x4, 6x6 or 8x8 texels), from
 * RGBA8 texels (rows of src_row_pitch bytes, edge texels replicated). One
 * partition; for each candidate block mode of the class (luminance,
 * luminance + alpha, RGB, RGBA, with or without a second weight plane for
 * alpha) it fits a line through the texels, fits the weight grid with the
 * decoder's infill, refines the endpoints by least squares, and keeps the
 * mode with the smallest error. Constant blocks become void-extent blocks.
 *
 * kind: 0 RGBA, 1 luminance (red), 2 luminance + alpha (red, green)
 */
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Words { uint w[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer OutWords { uint w[]; };
layout(push_constant) uniform PC {
   uvec2 src;
   uvec2 dst;
   uint src_row_pitch;
   uint src_slice_pitch;
   uint dst_row_pitch;
   uint dst_slice_pitch;
   uint blocks_x;
   uint blocks_y;
   uint block;
   uint kind;
   uint width;
   uint height;
} pc;
