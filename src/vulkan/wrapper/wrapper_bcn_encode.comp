#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_control_flow_attributes : require
/*
 * BCn encode, one invocation per 4x4 block, for reading back an emulated BC
 * image: texels in (RGBA8 or RGBA8_SNORM, 4 bytes, or RGBA16F, 8 bytes, rows
 * of src_row_pitch bytes, edge texels replicated past width/height), BC
 * blocks out. BC1-BC5 fit a line through the block, BC6H uses mode 11; BC7
 * tries mode 6, modes 1 and 3 on the two partitions that fit the block best
 * when it is opaque, and mode 5 when it is not, and keeps the smallest
 * error. Endpoints are refined once by least squares.
 *
 * format: 0 BC1, 1 BC1 without alpha, 2 BC2, 3 BC3, 4 BC4, 5 BC4 SNORM,
 *         6 BC5, 7 BC5 SNORM, 8 BC6H UF16, 9 BC6H SF16, 10 BC7
 * flags bit 0: the second BC5 channel is in alpha (luminance + alpha storage)
 */
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
/* one pipeline per format class, so each builds only its encoder:
 * 0 BC1-BC5, 1 BC6H, 2 BC7 */
layout(constant_id = 0) const uint FMT_CLASS = 0u;
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Words { uint w[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer OutWords { uint w[]; };
layout(push_constant) uniform PC {
   uvec2 src;
   uvec2 dst;
   uint src_row_pitch;
   uint src_slice_pitch;
   uint dst_row_pitch;
   uint dst_slice_pitch;
   uint blocks_x;
   uint blocks_y;
   uint format;
   uint flags;
   uint width;
   uint height;
} pc;

const int w2[4] = int[](0, 21, 43, 64);
const int w3[8] = int[](0, 9, 18, 27, 37, 46, 55, 64);
const int w4[16] = int[](0, 4, 9, 13, 17, 21, 26, 30, 34, 38, 43, 47, 51, 55, 60, 64);
